# coturn — Bow Down Visuals video-call TURN relay (Phase 1, Stack-200)
#
# Rendered by infra/coturn/setup.sh from this template:
#   __EXTERNAL_IP__  -> the Oracle VM's reserved public IP
#   __TURN_SECRET__  -> the static-auth-secret generated ON the VM
#                       (root-only file /etc/bowdown-turn-secret; the
#                       secret itself never lives in this repo)
#
# The API server mints EPHEMERAL per-member credentials from this
# secret (HMAC-SHA1 over "<expiry>:<userId>" — the coturn REST
# scheme, lib/video-calls.ts buildVideoCallIceConfig reusing the
# World voice signer). No long-term user passwords exist, so there
# is nothing to leak from a client: a stolen pair dies at expiry.
#
# This box also runs the owner's WireGuard (UDP 51820). coturn
# touches none of that: it binds 3478 + its relay range only, and
# the denied-peer rules below keep relayed traffic OUT of every
# private range — including the WireGuard subnet — so the relay can
# never be used as a tunnel into the LAN/VPN or cloud metadata.

listening-port=3478
listening-ip=0.0.0.0
external-ip=__EXTERNAL_IP__
realm=bowdownvisuals.com
server-name=turn.bowdownvisuals.com

fingerprint
use-auth-secret
static-auth-secret=__TURN_SECRET__
stale-nonce=600

# Relay port range (opened in iptables + the OCI security list).
min-port=49152
max-port=65535

# Abuse posture: no loopback, no multicast, no private-range peers.
no-loopback-peers
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Sane ceilings for a 1:1-calls relay on a small box.
total-quota=200
user-quota=8
max-bps=0
bps-capacity=0

no-cli
log-file=/var/log/turnserver.log
simple-log

# ── TLS (turns:) — Phase 2, deliberately OFF ────────────────────────
# Plain turn: on 3478 (UDP+TCP) is the Phase 1 relay. Media itself is
# DTLS-encrypted end-to-end by WebRTC regardless; TLS here would only
# hide the signaling metadata of the relay hop. To enable turns: on
# 5349 later: point DNS turn.bowdownvisuals.com at this box, issue a
# Let's Encrypt cert for it, and uncomment:
# tls-listening-port=5349
# cert=/etc/letsencrypt/live/turn.bowdownvisuals.com/fullchain.pem
# pkey=/etc/letsencrypt/live/turn.bowdownvisuals.com/privkey.pem
