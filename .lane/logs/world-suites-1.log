[31m+     new THREE.BoxGeometry(0.22, 0.055, 0.05),[39m
[31m+     new THREE.MeshStandardMaterial({ color: GOLD, emissive: GOLD_DEEP, emissiveIntensity: 0.7, roughness: 0.3, metalness: 0.8 }),[39m
[31m+   );[39m
[31m+   visor.position.set(0, 1.86, -0.19);[39m
