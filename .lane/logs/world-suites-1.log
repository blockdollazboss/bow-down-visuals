[31m+   if (size.width === 0 || size.height === 0) return;[39m
[31m+   if (size.width === img.width && size.height === img.height) return;[39m
[31m+   try {[39m
[31m+     const canvas = document.createElement("canvas");[39m
[31m+     canvas.width = size.width;[39m
[31m+     canvas.height = size.height;[39m
[31m+     const g = canvas.getContext("2d");[39m
