[31m+     }[39m
[31m+   }[39m
[31m+[39m
[31m+   /** Shared play/pause for the screen's video, from the room's[39m
[31m+    *  server-stamped state. A drift beyond a couple of seconds snaps[39m
[31m+    *  to the stamped position; inside it, local playback just runs —[39m
[31m+    *  approximate sync is the v1 bar, honestly. */[39m
[31m+   setScreenPlayback(playing: boolean, positionSec: number): void {[39m
[31m+     const video = this.video;[39m
