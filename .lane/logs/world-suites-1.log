[31m+   private rippleNormalFor(repeatX: number, repeatY: number): THREE.Texture {[39m
[31m+     const tex = rippleNormalTexture().clone();[39m
[31m+     tex.wrapS = THREE.RepeatWrapping;[39m
[31m+     tex.wrapT = THREE.RepeatWrapping;[39m
[31m+     tex.repeat.set(repeatX, repeatY);[39m
