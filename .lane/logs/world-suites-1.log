[31m+         const slab = new THREE.Mesh(new THREE.BoxGeometry(2.14, 3.4, 0.1), darkSlab);[39m
[31m+         slab.position.set(sx * -1.07, 1.7, 0);[39m
[31m+         leaf.add(slab);[39m
[31m+         const trim = new THREE.Mesh(new THREE.BoxGeometry(2.1, 0.07, 0.12), mats.gold);[39m
[31m+         trim.position.set(sx * -1.07, 3.3, 0);[39m
[31m+         leaf.add(trim);[39m
[31m+         const handle = new THREE.Mesh(new THREE.SphereGeometry(0.055, 10, 8), mats.gold);[39m
[31m+         handle.position.set(sx * -1.9, 1.55, -0.08);[39m
[31m+         leaf.add(handle);[39m
