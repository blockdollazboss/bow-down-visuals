[31m+   /** A doorway's name plate, hung over the arch on the face the[39m
[31m+    *  `rotY` turns it toward. */[39m
[31m+   private doorPlate([39m
[31m+     group: THREE.Group, text: string, x: number, y: number, z: number, rotY: number, width = 3.4,[39m
[31m+   ): void {[39m
[31m+     const plate = new THREE.Mesh([39m
[31m+       new THREE.PlaneGeometry(width, (width * 224) / 1024),[39m
