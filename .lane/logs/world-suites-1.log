[31m+       if (Math.abs(video.currentTime - positionSec) > 2.5) {[39m
[31m+         try {[39m
[31m+           video.currentTime = Math.min(positionSec, Math.max(0, video.duration - 0.25));[39m
[31m+         } catch {[39m
