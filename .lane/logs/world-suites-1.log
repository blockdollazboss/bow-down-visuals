[31m+     this.wallRunZ(group, mats, -14.2, -18.4, -15, 0, H, 1);[39m
[31m+     this.wallRunZ(group, mats, -14.2, -12, -3.5, 0, H, 1);[39m
[31m+     this.wallRunZ(group, mats, -14.2, -0.5, 3.5, 0, H, 1);[39m
[31m+     this.wallRunZ(group, mats, -14.2, 6.5, 12.4, 0, H, 1);[39m
[31m+     this.wallRunZ(group, mats, -14.2, -15, -12, DH, H, 1);[39m
[31m+     this.wallRunZ(group, mats, -14.2, -3.5, -0.5, DH, H, 1);[39m
[31m+     this.wallRunZ(group, mats, -14.2, 3.5, 6.5, DH, H, 1);[39m
[31m+     this.doorArchZ(group, mats, -14.2, -15, -12);[39m
[31m+     this.doorArchZ(group, mats, -14.2, -3.5, -0.5);[39m
[31m+     this.doorArchZ(group, mats, -14.2, 3.5, 6.5);[39m
[31m+     this.doorPlate(group, "TREASURY", -13.93, DH + 0.66, -13.5, Math.PI / 2);[39m
[31m+     this.doorPlate(group, "MUSIC HALL", -13.93, DH + 0.66, -2, Math.PI / 2);[39m
