[31m+           const hls = new Hls({ maxBufferLength: 12 });[39m
[31m+           hls.loadSource(source.hlsUrl);[39m
[31m+           hls.attachMedia(video);[39m
[31m+           this.hls = hls;[39m
[31m+         } else {[39m
[31m+           video.src = source.hlsUrl;[39m
[31m+         }[39m
[31m+       }[39m
[31m+     } else if (source.videoUrl) {[39m
[31m+       video.src = source.videoUrl;[39m
[31m+     } else {[39m
[31m+       return;[39m
[31m+     }[39m
[31m+[39m
[31m+     if (!this.videoTexture) {[39m
