[31m+         map: flameTexture(), transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,[39m
[31m+       }));[39m
[31m+       flame.scale.set(0.085, 0.17, 1);[39m
[31m+       flame.position.set(dx, 3.62, 0.26);[39m
[31m+       sconce.add(flame);[39m
[31m+       anim.flames.push({ sprite: flame, baseX: 0.085, baseY: 0.17, phase: Math.random() * 20 });[39m
[31m+     }[39m
[31m+     const glow = new THREE.Sprite(new THREE.SpriteMaterial({[39m
