[31m+   /* ── Water round 2 helpers (Stack-100 #2 items 5–7) ──────────[39m
[31m+    * Every water surface in the world is built the same way: the[39m
[31m+    * look's water colour texture (cloned, scrolled by the tick)[39m
[31m+    * PLUS a cloned ripple normal texture the same tick counter-[39m
[31m+    * scrolls — the surface bends light, not just slides a picture.[39m
[31m+    * And every basin wears the wet edge: a dark band on the water[39m
[31m+    * at its rim (plaza-life's WET_EDGE), so water meets stone[39m
[31m+    * like water, not like a decal. */[39m
[31m+[39m
[31m+   /** A per-surface ripple normal texture: shared pixels, own[39m
[31m+    *  repeat + own offset (the tick animates the offset). */[39m
[31m+   private rippleNormalFor(repeatX: number, repeatY: number): THREE.Texture {[39m
[31m+     const tex = rippleNormalTexture().clone();[39m
[31m+     tex.wrapS = THREE.RepeatWrapping;[39m
[31m+     tex.wrapT = THREE.RepeatWrapping;[39m
[31m+     tex.repeat.set(repeatX, repeatY);[39m
[31m+     tex.needsUpdate = true;[39m
[31m+     return tex;[39m
[31m+   }[39m
[31m+[39m
[31m+   private wetEdgeMaterial(): THREE.MeshBasicMaterial {[39m
[31m+     return new THREE.MeshBasicMaterial({[39m
[31m+       color: WET_EDGE.color, transparent: true, opacity: WET_EDGE.opacity, depthWrite: false,[39m
[31m+     });[39m
[31m+   }[39m
[31m+[39m
[31m+   /** The wet edge for a rectangular basin: four flat strips just[39m
[31m+    *  inside the rim, hovering a breath over the water. */[39m
[31m+   private wetEdgeRect(cx: number, cz: number, w: number, d: number, waterY: number): THREE.Group {[39m
[31m+     const g = new THREE.Group();[39m
[31m+     const mat = this.wetEdgeMaterial();[39m
[31m+     const bw = WET_EDGE.width;[39m
[31m+     const y = waterY + WET_EDGE.lift;[39m
[31m+     const strips: Array<{ w: number; d: number; x: number; z: number }> = [[39m
[31m+       { w, d: bw, x: cx, z: cz - d / 2 + bw / 2 },[39m
[31m+       { w, d: bw, x: cx, z: cz + d / 2 - bw / 2 },[39m
[31m+       { w: bw, d: d - bw * 2, x: cx - w / 2 + bw / 2, z: cz },[39m
[31m+       { w: bw, d: d - bw * 2, x: cx + w / 2 - bw / 2, z: cz },[39m
[31m+     ];[39m
[31m+     for (const s of strips) {[39m
[31m+       const m = new THREE.Mesh(new THREE.PlaneGeometry(s.w, s.d), mat);[39m
[31m+       m.rotation.x = -Math.PI / 2;[39m
[31m+       m.position.set(s.x, y, s.z);[39m
[31m+       m.renderOrder = 2;[39m
[31m+       g.add(m);[39m
[31m+     }[39m
[31m+     return g;[39m
[31m+   }[39m
[31m+[39m
[31m+   /** The wet edge for a round basin: one flat ring at the rim. */[39m
[31m+   private wetEdgeRing(cx: number, cz: number, r: number, waterY: number): THREE.Mesh {[39m
[31m+     const m = new THREE.Mesh([39m
[31m+       new THREE.RingGeometry(r - WET_EDGE.width, r, 36),[39m
[31m+       this.wetEdgeMaterial(),[39m
[31m+     );[39m
[31m+     m.rotation.x = -Math.PI / 2;[39m
[31m+     m.position.set(cx, waterY + WET_EDGE.lift, cz);[39m
[31m+     m.renderOrder = 2;[39m
[31m+     return m;[39m
[31m+   }[39m
