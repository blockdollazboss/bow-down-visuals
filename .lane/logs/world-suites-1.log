[31m+      * derived PBR maps registered for this URL (pbr-materials). */[39m
[31m+     enhanceLoadedTexture(url, loaded);[39m
[31m+     /* Item 93: on a stepped-down rung the decoded set shrinks with[39m
[31m+      * it — same source file, smaller canvas, a fraction of the[39m
[31m+      * memory (the scale squares: medium ≈ 1/4 the pixels). */[39m
[31m+     if (activeTextureScale < 1) downscaleTextureImage(loaded, activeTextureScale);[39m
[31m+   }, undefined, () => {[39m
