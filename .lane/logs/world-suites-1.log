[31m+[39m
[31m+   /** A BACKED, two-faced plate (Stack-100 #2 gates round): the[39m
[31m+    *  district gates' name plates used to be one single-sided[39m
[31m+    *  plane — from the district side a walker saw through the[39m
[31m+    *  gate's name entirely. Now the plate is a thin gilt slab[39m
[31m+    *  (cast + receive shadow) wearing the lettering on BOTH faces,[39m
[31m+    *  each face reading correctly from its own side. */[39m
[31m+   private doorPlateBacked([39m
[31m+     group: THREE.Group, text: string, x: number, y: number, z: number, rotY: number, width: number,[39m
[31m+     mats: LookMaterials,[39m
[31m+   ): void {[39m
[31m+     const h = (width * 224) / 1024;[39m
[31m+     const holder = new THREE.Group();[39m
[31m+     holder.position.set(x, y, z);[39m
[31m+     holder.rotation.y = rotY;[39m
[31m+     const slab = new THREE.Mesh(new THREE.BoxGeometry(width + 0.06, h + 0.06, 0.045), mats.goldDark);[39m
[31m+     slab.castShadow = true;[39m
[31m+     slab.receiveShadow = true;[39m
[31m+     holder.add(slab);[39m
[31m+     for (const side of [1, -1] as const) {[39m
[31m+       const face = new THREE.Mesh([39m
[31m+         new THREE.PlaneGeometry(width, h),[39m
[31m+         new THREE.MeshBasicMaterial({ map: doorPlateTexture(text), toneMapped: false }),[39m
[31m+       );[39m
[31m+       face.position.z = side * 0.026;[39m
[31m+       if (side < 0) face.rotation.y = Math.PI;[39m
[31m+       holder.add(face);[39m
[31m+     }[39m
[31m+     group.add(holder);[39m
[31m+   }[39m
