[31m+  * them alongside the colour cache on every step. */[39m
[31m+ let activeRungAnisotropy = 16;[39m
[31m+ const rungSurfaceTextures = new Set<THREE.Texture>();[39m
[31m+[39m
[31m+ /* Item 93: the active rung's texture decode scale, consulted by[39m
[31m+  * hallTexture's load callback (see steppedTextureSize in[39m
[31m+  * quality.ts). Seeded from the boot rung, moved by ladder steps;[39m
[31m+  * textures already decoded keep their size until they reload. */[39m
[31m+ let activeTextureScale = 1;[39m
[31m+[39m
[31m+ /** Canvas-downscale a freshly landed texture image to the active[39m
[31m+  *  rung's decode size (item 93 — the figure-canvas precedent: draw[39m
[31m+  *  the source onto a smaller canvas and hand THAT to the GPU). The[39m
[31m+  *  shared tileable canvas enhanceLoadedTexture installed is only[39m
[31m+  *  READ here; each texture gets its own stepped canvas. */[39m
[31m+ function downscaleTextureImage(tex: THREE.Texture, scale: number): void {[39m
[31m+   const img = tex.image as { width?: number; height?: number } | undefined;[39m
[31m+   if (!img) return;[39m
