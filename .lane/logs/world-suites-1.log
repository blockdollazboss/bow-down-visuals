[31m+     arm.position.set(0, 3.3, 0.14);[39m
[31m+     sconce.add(arm);[39m
[31m+     const candleMat = new THREE.MeshStandardMaterial({ color: 0xf3e5c0, roughness: 0.6 });[39m
[31m+     for (const dx of [-0.09, 0, 0.09]) {[39m
[31m+       const candle = new THREE.Mesh(new THREE.CylinderGeometry(0.022, 0.022, 0.2, 8), candleMat);[39m
[31m+       candle.position.set(dx, 3.44, 0.26);[39m
