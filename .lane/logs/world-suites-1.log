[31m+[39m
[31m+   /** The wet edge for a rectangular basin: four flat strips just[39m
[31m+    *  inside the rim, hovering a breath over the water. */[39m
[31m+   private wetEdgeRect(cx: number, cz: number, w: number, d: number, waterY: number): THREE.Group {[39m
[31m+     const g = new THREE.Group();[39m
