[31m+     if (west) this.doorPlate(g, "THE KING'S HALL", -14.52, PALACE_DOOR_HEIGHT + 0.66, doorCenter, -Math.PI / 2);[39m
[31m+     else this.doorPlate(g, "THE KING'S HALL", 14.52, PALACE_DOOR_HEIGHT + 0.66, doorCenter, Math.PI / 2);[39m
[31m+[39m
[31m+     this.shellLantern(g, look, cx, cz);[39m
