[31m+     // Treasury −17.9..−9.2, Create −8.6..3.1, Royal Court[39m
[31m+     // −17.9..−9.2, Branding 3.5..11.9.[39m
[31m+     if (west) {[39m
[31m+       this.wallRunZ(g, mats, -28.4, interior.minZ - 0.2, interior.maxZ + 0.2, 0, 6.5, 1);[39m
[31m+       this.wallRunX(g, mats, interior.minZ - 0.2, -28.4, -14.2, 0, 6.5, 1);[39m
[31m+       this.wallRunX(g, mats, interior.maxZ + 0.2, -28.4, -14.2, 0, 6.5, -1);[39m
[31m+     } else {[39m
[31m+       this.wallRunZ(g, mats, 28.4, interior.minZ - 0.2, interior.maxZ + 0.2, 0, 6.5, -1);[39m
[31m+       this.wallRunX(g, mats, interior.minZ - 0.2, 14.2, 28.4, 0, 6.5, 1);[39m
[31m+       this.wallRunX(g, mats, interior.maxZ + 0.2, 14.2, 28.4, 0, 6.5, -1);[39m
[31m+     }[39m
[31m+[39m
