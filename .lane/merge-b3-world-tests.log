[31m+     for (const roomId of [MUSIC_HALL_ID, GAME_ROOMS_ID, CREATE_WING_ID, TREASURY_ID, ROYAL_COURT_ID, BRANDING_ATELIER_ID]) {[39m
[31m+       this.buildIndoorShell(group, look, mats, roomId);[39m
[31m+     }[39m
[31m+     this.buildCourtyardShell(group, look, mats, anim);[39m
[31m+     this.buildCreatorRoomShell(group, look, mats);[39m
