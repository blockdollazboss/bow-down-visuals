[31m+   }[39m
[31m+[39m
[31m+   /** A polished marble floor (no reflector — the hall owns the one[39m
[31m+    *  mirror) with the palace's gold inlay border. */[39m
[31m+   private shellFloor([39m
[31m+     g: THREE.Group, look: HallLook, mats: LookMaterials,[39m
[31m+     rect: { minX: number; maxX: number; minZ: number; maxZ: number },[39m
[31m+     kind: PbrKind,[39m
[31m+   ): void {[39m
[31m+     const w = rect.maxX - rect.minX;[39m
[31m+     const d = rect.maxZ - rect.minZ;[39m
[31m+     const cx = (rect.minX + rect.maxX) / 2;[39m
[31m+     const cz = (rect.minZ + rect.maxZ) / 2;[39m
[31m+     /* Per-metre repeat (item 7) — the old code rounded w/7 to whole[39m
[31m+      * tiles, so every rect snapped to a different texel density.[39m
[31m+      * Derived PBR maps ride along (item 9); roughness is encoded[39m
[31m+      * in the kind's map, so the scalar is 1. */[39m
[31m+     const rep = repeatForSize(w, d, MARBLE_METRES_PER_TILE);[39m
[31m+     const map = hallTexture(look.marbleTextureUrl, rep.x, rep.y);[39m
[31m+     const pbr = derivedPbrTextures(look.marbleTextureUrl, kind, rep.x, rep.y);[39m
[31m+     for (const t of [pbr.normalMap, pbr.roughnessMap, pbr.aoMap]) t.anisotropy = maxTextureAnisotropy;[39m
[31m+     const floor = new THREE.Mesh([39m
[31m+       new THREE.PlaneGeometry(w, d),[39m
[31m+       new THREE.MeshPhysicalMaterial({[39m
[31m+         map,[39m
[31m+         normalMap: pbr.normalMap, normalScale: new THREE.Vector2(0.5, 0.5),[39m
[31m+         roughnessMap: pbr.roughnessMap, aoMap: pbr.aoMap,[39m
[31m+         transparent: true, opacity: 0.97,[39m
[31m+         roughness: 1, metalness: 0, clearcoat: 0.4, clearcoatRoughness: 0.35,[39m
[31m+         envMapIntensity: 0.8, depthWrite: false,[39m
[31m+       }),[39m
[31m+     );[39m
[31m+     floor.rotation.x = -Math.PI / 2;[39m
[31m+     floor.position.set(cx, 0.012, cz);[39m
[31m+     floor.renderOrder = 2;[39m
[31m+     floor.receiveShadow = QUALITY[this.quality].shadows;[39m
[31m+     g.add(floor);[39m
[31m+     const inset = 0.55;[39m
[31m+     const strip = (sw: number, sd: number, x: number, z: number) => {[39m
[31m+       const s = new THREE.Mesh(new THREE.BoxGeometry(sw, 0.012, sd), mats.goldDark);[39m
[31m+       s.position.set(x, 0.02, z);[39m
[31m+       g.add(s);[39m
[31m+     };[39m
[31m+     strip(w - inset * 2, 0.07, cx, rect.minZ + inset);[39m
[31m+     strip(w - inset * 2, 0.07, cx, rect.maxZ - inset);[39m
[31m+     strip(0.07, d - inset * 2, rect.minX + inset, cz);[39m
[31m+     strip(0.07, d - inset * 2, rect.maxX - inset, cz);[39m
[31m+   }[39m
[31m+[39m
[31m+   /** A gilt panel frame on a shell's far wall — the palace's wall[39m
