[31m+   /** Aim the one directional + the fog for the area the visitor[39m
[31m+    *  stands in. Indoors: the standing hall rig (window sun by day,[39m
[31m+    *  dark at night, hall fog). On the plaza: a real sun over the[39m
[31m+    *  grounds by day (or cool moonlight at night) with a shadow[39m
[31m+    *  camera fitted to the plaza plan, and outdoor fog distances —[39m
[31m+    *  the hall's fog (dark 16–46 m) otherwise swallows the palace[39m
[31m+    *  from its own front door (audit C1). One light, re-aimed: no[39m
[31m+    *  second shadow pass, no spill into the hall. */[39m
[31m+   private aimSun(): void {[39m
[31m+     const sun = this.sunLight;[39m
[31m+     const tgt = this.sunTarget;[39m
[31m+     if (!sun || !tgt) return;[39m
[31m+     const look = hallLookFor(this.theme);[39m
[31m+     const cam = sun.shadow.camera;[39m
[31m+     if (this.currentRoom === COURTYARD_ID && look.sun.present) {[39m
[31m+       // Day on the plaza: sun high in the southern sky, so the[39m
[31m+       // palace facade and the monument throw real shadows.[39m
[31m+       sun.position.set(16, 25, 47);[39m
[31m+       tgt.position.set(0, 0, 20);[39m
[31m+       sun.color.set(look.sun.color);[39m
[31m+       sun.intensity = look.sun.intensity;[39m
[31m+       cam.left = -36; cam.right = 36; cam.top = 36; cam.bottom = -36;[39m
[31m+       cam.near = 1; cam.far = 120;[39m
[31m+     } else if (this.currentRoom === COURTYARD_ID) {[39m
[31m+       // Night on the plaza: moonlight — cool, dim, shadow-casting.[39m
[31m+       sun.position.set(-14, 27, 42);[39m
[31m+       tgt.position.set(0, 0, 20);[39m
[31m+       sun.color.set(0x93a7d4);[39m
[31m+       sun.intensity = 0.6;[39m
[31m+       cam.left = -36; cam.right = 36; cam.top = 36; cam.bottom = -36;[39m
[31m+       cam.near = 1; cam.far = 120;[39m
[31m+     } else {[39m
[31m+       sun.position.set(-13.5, 10.5, -1);[39m
[31m+       tgt.position.set(7, 0, -5);[39m
[31m+       sun.color.set(look.sun.color);[39m
[31m+       sun.intensity = look.sun.present ? look.sun.intensity : 0;[39m
[31m+       cam.left = -20; cam.right = 20; cam.top = 20; cam.bottom = -20;[39m
[31m+       cam.near = 1; cam.far = 45;[39m
[31m+     }[39m
[31m+     cam.updateProjectionMatrix();[39m
[31m+     tgt.updateMatrixWorld();[39m
[31m+     // The casters are static per aim — one fresh shadow render.[39m
[31m+     this.renderer.shadowMap.needsUpdate = true;[39m
[31m+   }[39m
