[31m+     /* The source landed: swap in its tileable variant and fill the[39m
[31m+      * derived PBR maps registered for this URL (pbr-materials). */[39m
[31m+     enhanceLoadedTexture(url, loaded);[39m
[31m+   }, undefined, () => {[39m
[31m+     /* Overhaul audit T14: a slow/blocked/CORS-failed CDN copy used[39m
[31m+      * to leave the surface untextured black with no recovery. Fall[39m
[31m+      * back to the same asset on the site origin (the public/ copy[39m
[31m+      * still ships with the app); if that fails too, the material's[39m
[31m+      * own colour carries the surface instead of a black hole. */[39m
[31m+     if (path !== url) {[39m
[31m+       new THREE.ImageLoader().load([39m
[31m+         url,[39m
[31m+         (img) => {[39m
[31m+           tex.image = img;[39m
[31m+           tex.needsUpdate = true;[39m
[31m+         },[39m
[31m+         undefined,[39m
[31m+         () => undefined,[39m
[31m+       );[39m
[31m+     }[39m
[31m+   });[39m
[31m+   tex.colorSpace = THREE.SRGBColorSpace;[39m
[31m+   tex.wrapS = THREE.RepeatWrapping;[39m
