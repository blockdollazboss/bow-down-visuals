[31m+   /** Dust motes hanging in the sunbeams (Look A). */[39m
[31m+   private buildDust(group: THREE.Group): THREE.Points {[39m
[31m+     const count = 340;[39m
[31m+     const positions = new Float32Array(count * 3);[39m
[31m+     for (let i = 0; i < count; i++) {[39m
[31m+       positions[i * 3] = -13.5 + Math.random() * 15.5;[39m
[31m+       positions[i * 3 + 1] = 0.3 + Math.random() * 5.3;[39m
[31m+       positions[i * 3 + 2] = -11.5 + Math.random() * 19;[39m
[31m+     }[39m
[31m+     const geo = new THREE.BufferGeometry();[39m
[31m+     geo.setAttribute("position", new THREE.BufferAttribute(positions, 3));[39m
[31m+     /* Item 99: the rung's particle scale draws a prefix of the[39m
[31m+      * motes — geometry is built full-size so a step UP restores[39m
[31m+      * them without a rebuild (applyTierToRenderer re-ranges). */[39m
[31m+     geo.setDrawRange(0, Math.floor(count * QUALITY[this.quality].particleScale));[39m
[31m+     const dust = new THREE.Points(geo, new THREE.PointsMaterial({[39m
[31m+       map: hazeTexture(), size: 0.055, transparent: true, opacity: 0.5, color: 0xffe9bb,[39m
[31m+       blending: THREE.AdditiveBlending, depthWrite: false, sizeAttenuation: true,[39m
[31m+     }));[39m
[31m+     dust.renderOrder = 5;[39m
[31m+     group.add(dust);[39m
[31m+     return dust;[39m
[31m+   }[39m
[31m+[39m
[31m+   /** Slow haze sheets drifting over the midnight floor (Look B). */[39m
[31m+   private buildHaze(group: THREE.Group, anim: LookAnim): void {[39m
[31m+     const specs: Array<[number, number, number]> = [[39m
[31m+       [0, 2.3, -8], [-5.5, 2.7, -1], [5.5, 2.1, 3.5], [0, 2.9, -13.5],[39m
[31m+     ];[39m
[31m+     specs.forEach(([x, y, z], i) => {[39m
[31m+       const sheet = new THREE.Mesh([39m
[31m+         new THREE.PlaneGeometry(11, 4.2),[39m
[31m+         new THREE.MeshBasicMaterial({[39m
[31m+           map: hazeTexture(), transparent: true, opacity: 0.15, depthWrite: false,[39m
[31m+           fog: false, color: 0xa89372, side: THREE.DoubleSide,[39m
[31m+         }),[39m
[31m+       );[39m
[31m+       sheet.position.set(x, y, z);[39m
[31m+       sheet.rotation.y = i * 0.7;[39m
[31m+       sheet.renderOrder = 4;[39m
[31m+       group.add(sheet);[39m
[31m+       anim.smokes.push({ mesh: sheet, baseX: x, phase: i * 1.7, speed: 0.5 + (i % 3) * 0.3 });[39m
[31m+     });[39m
[31m+   }[39m
[31m+[39m
[31m+   /* ── The palace rooms (shells) ────────────────────────────────────[39m
[31m+      Each room beyond the hall is built to the palace's materials in[39m
[31m+      the current look: polished marble floor with the gold inlay,[39m
[31m+      marble walls with the trim line, a ceiling with a lantern for[39m
[31m+      the indoor rooms, low marble walls and planters for the open[39m
[31m+      Courtyard. SHELLS, deliberately: no jukebox, no game tables, no[39m
[31m+      desks — each room's features dock in their own lane. The one[39m
[31m+      mirror floor stays in the hall (the plan's performance law):[39m
[31m+      shells get the polished overlay only, no second Reflector. */[39m
[31m+[39m
[31m+   private buildRoomShells(group: THREE.Group, look: HallLook, mats: LookMaterials, anim: LookAnim): void {[39m
[31m+     this.shellMats = mats;[39m
