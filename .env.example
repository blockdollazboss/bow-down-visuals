# Bow Down Visuals — environment variables.
# Copy to .env for local dev. On Render, set these in the service's Environment tab.
# NEVER commit a real .env.

# ── Core ──────────────────────────────────────────────────────────────────
DATABASE_URL=                    # Render Postgres (Drizzle tables live here)
SUPABASE_URL=                    # Supabase project URL
SUPABASE_ANON_KEY=               # Supabase anon key
SUPABASE_SERVICE_ROLE_KEY=       # Supabase service-role key (server only)
OPENAI_API_KEY=                  # OpenAI (text models, image models)
PORT=5000

# ── Instagram auto-post MVP (feature/instagram-auto-post) ────────────────
# Meta app for Instagram Content Publishing. Create it at
# https://developers.facebook.com/apps — you'll need App Review approval for
# the instagram_business_content_publish permission before real users can post.
META_APP_ID=
META_APP_SECRET=                 # server only — never expose to the frontend
# Must match the OAuth redirect URI registered in the Meta app dashboard.
META_REDIRECT_URI=https://bowdownvisuals.com/api/social/instagram/callback
# AES-256-GCM key for encrypting stored OAuth tokens (64 hex chars = 32 bytes).
# Generate: openssl rand -hex 32
# REQUIRED — the server refuses to connect accounts or publish without it.
SOCIAL_TOKEN_KEY=
# Credits charged per Instagram post (Meta's API is free; this is margin).
INSTAGRAM_POST_CREDITS=2

# ── Other providers ───────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
LIP_SYNC_API_KEY=                # Sync.so
ADMIN_EMAILS=                    # comma-separated owner emails
