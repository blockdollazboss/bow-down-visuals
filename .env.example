# Bow Down Visuals — environment variables
# ============================================================================
# Copy to `.env` for local dev. On Render, set these in the service's
# Environment tab (bow-down-visuals -> Environment).
# NEVER commit a real `.env` — this file holds placeholders only.
#
# Conventions: REQUIRED = the app (or a feature) fails without it.
#              optional  = safe to omit; the documented default applies.
# ============================================================================

# ── App ────────────────────────────────────────────────────────────────────
# Port the API server listens on. Render injects PORT automatically.
PORT=8080                                    # optional, default 8080
# production | development. Enables dev-only routes and verbose errors when
# set to "development". NEVER "development" in production.
NODE_ENV=production                          # REQUIRED in prod
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info                               # optional, default info
# Where the server finds the built frontend (serves it as static files).
FRONTEND_DIST=                               # optional, default <server>/../../bow-down-visuals/dist/public

# ── Database ───────────────────────────────────────────────────────────────
# Postgres connection string (Render "bow-down-visuals-db").
# REQUIRED — the server refuses to boot without it.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Supabase ───────────────────────────────────────────────────────────────
# Project URL. The server also accepts VITE_SUPABASE_URL as a fallback.
SUPABASE_URL=https://xyzcompany.supabase.co        # REQUIRED
# Anon (public) key — used for auth verification and the /config endpoint.
SUPABASE_ANON_KEY=                                 # REQUIRED
# Service-role key — full storage/admin access. SERVER ONLY, never expose.
SUPABASE_SERVICE_ROLE_KEY=                         # REQUIRED

# ── Stripe (payments) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...                      # REQUIRED for checkout

# ── Resend (transactional email) ───────────────────────────────────────────
# Without RESEND_API_KEY the app runs in fail-open mode: emails are skipped
# with a warning log and { sent: false, reason: "no-provider" } — purchases,
# invites and payouts NEVER break. Set a real key to send receipts, invites,
# subscription confirmations, payout notices and DMCA operator alerts.
# Create a free account at https://resend.com, verify bowdownvisuals.com
# (add the SPF/DKIM records Resend gives you in Cloudflare DNS), then
# generate an API key. Never paste the key in chat — set it on Render
# (staging + production) via the dashboard environment tab.
RESEND_API_KEY=                                    # REQUIRED for email sending
# Sender address. Must be on a domain verified in Resend.
EMAIL_FROM=noreply@bowdownvisuals.com
# ── Branding Shop (dropship via Printful) ──────────────────────────────────
# Without PRINTFUL_API_KEY the shop runs in clearly-labeled mock (sandbox)
# mode: the full order → fulfillment → tracking flow is simulated end-to-end.
# Add a live key to ship real products. Create it at:
# Printful Dashboard -> Settings -> API.
PRINTFUL_API_KEY=                                  # optional; enables LIVE fulfillment
# Per-product Printful sync variant IDs (live mode only). Find them in the
# Printful dashboard under your synced products; ops sets these per product.
#PRINTFUL_VARIANT_TSHIRT=
#PRINTFUL_VARIANT_HOODIE=
#PRINTFUL_VARIANT_MUG=
#PRINTFUL_VARIANT_SNAPBACK=
#PRINTFUL_VARIANT_POSTER=
#PRINTFUL_VARIANT_PHONECASE=
#PRINTFUL_VARIANT_TOTE=
# Shared secret for the Printful webhook (POST /api/branding-shop/webhooks/printful).
# Set a random string here AND in the Printful dashboard webhook settings.
PRINTFUL_WEBHOOK_SECRET=                           # optional; REQUIRED for live webhooks
# AI brand-kit design cost (credits) and design generation timeout.
BRANDING_SHOP_DESIGN_COST=2                        # optional, default 2
BRANDING_SHOP_DESIGN_TIMEOUT_MS=180000             # optional, default 180000
STRIPE_WEBHOOK_SECRET=whsec_...                    # REQUIRED for webhooks
# Stripe Price IDs for the credit packs (Stripe Dashboard -> Products).
STRIPE_PRICE_10_CREDITS=price_...                  # REQUIRED for checkout
STRIPE_PRICE_50_CREDITS=price_...                  # REQUIRED for checkout
STRIPE_PRICE_150_CREDITS=price_...                 # REQUIRED for checkout
STRIPE_PRICE_500_CREDITS=price_...                 # REQUIRED for checkout
# Stripe Price IDs for the Creator tier subscriptions (TIER_PLANS in
# artifacts/api-server/src/lib/platform-fees.ts: Pro $12/mo, Elite $29/mo,
# TEST mode until launch). Checkout refuses a tier whose id is unset.
STRIPE_PRICE_TIER_PRO=price_...                    # REQUIRED for Pro checkout
STRIPE_PRICE_TIER_ELITE=price_...                  # REQUIRED for Elite checkout
# Hosting plan (platform-fees.ts HOSTING_PLAN): unpriced until BOTH are set.
STRIPE_PRICE_HOSTING=price_...                     # optional, Hosting checkout
HOSTING_PRICE_USD_PER_MONTH=                       # optional, Hosting price (USD/mo)

# ── OpenAI (text + image) ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                              # REQUIRED for AI features
# Model overrides — newest-model policy: bump these, not code.
OPENAI_TEXT_MODEL=gpt-6-sol                        # optional, default gpt-6-sol
OPENAI_IMAGE_MODEL_25=gpt-image-2.5-sunburst        # optional, default gpt-image-2.5-sunburst

# ── Runway (video + artist images) ─────────────────────────────────────────
RUNWAYML_API_SECRET=                               # REQUIRED for video/image gen
# Site credits charged per second of Seedance 2.5 footage.
SEEDANCE_CREDITS_PER_SEC=2                         # optional, default 2

# ── ElevenLabs (music + voice) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=                                # REQUIRED for music/voice
ELEVENLABS_STS_MODEL=eleven_english_sts_v2         # optional, default eleven_english_sts_v2
ELEVENLABS_STS_TIMEOUT_MS=300000                   # optional, default 300000 (5 min)
ELEVENLABS_SCRIBE_MODEL=scribe_v2                  # optional, default scribe_v2 (timed transcription: captions, lyric alignment, dubbing)
# Thy Cheat Code's designed voice (chat spoken replies, POST /api/chat/speak).
# Unset = his voice is still being cast: speak status reports not-ready and
# nothing is ever charged. Set to the ElevenLabs voice_id once designed.
THY_CHEAT_CODE_VOICE_ID=                           # optional, no default
CHAT_SPEAK_CREDITS=100                             # optional, default 100 (Visual Bucs per spoken reply)
# Thy Cheat Code's hands (Cloud Operator Phase 2): the kill switch for
# operator-run actions. Default ON — set to 0 to still his hands (every
# execution refuses, audited; questions and the action log keep working).
OPERATOR_HANDS_ENABLED=1                           # optional, default 1 (enabled)

# ── Cloud Operator Phase 2, Lane G — automatic duties ─────────────────────
# Thy Cheat Code's peace-keeping watch: host reminders before booked
# palace events, winner heralds on contest decisions + Court Season
# settlements, and trouble flags filed into the moderators' queue.
# Duties NEVER punish (no auto-mute/kick/remove/lock, ever — flagging
# is the ceiling) and every firing writes an operator_actions row
# with channel 'automatic'. Master switch + one switch per duty; all
# default ON. Set to 0/false/off to still a switch.
OPERATOR_DUTIES_ENABLED=1                          # optional, default 1 (enabled)
OPERATOR_DUTY_HOST_REMINDERS_ENABLED=1             # optional, default 1 (enabled)
OPERATOR_DUTY_WINNER_HERALDS_ENABLED=1             # optional, default 1 (enabled)
OPERATOR_DUTY_TROUBLE_FLAGGING_ENABLED=1           # optional, default 1 (enabled)

# ── Pexels (stock media library — free browsing, 50 VB per import) ─────────
# Required for GET /api/stock/search + POST /api/stock/import. Free Pexels API
# key at https://www.pexels.com/api/. When unset, /api/stock/search returns
# 503 with error "stock_not_configured" and the editor panel shows a
# dormant notice instead of results.
PEXELS_API_KEY=                                    # REQUIRED for stock media

# ── Lip-sync providers ─────────────────────────────────────────────────────
# DEFAULT route: LatentSync via WaveSpeed (owner's verdict 2026-10-24 —
# clean against timed lyrics). Used whenever WAVESPEED_API_KEY is set and
# LIP_SYNC_PROVIDER does not override it. NOTE: the account is prepaid —
# an empty balance fails lip-sync jobs closed (provider_balance) until
# it is funded.
WAVESPEED_API_KEY=                                 # REQUIRED for the default lip-sync route
# LIP_SYNC_LATENTSYNC_MODEL=bytedance/latentsync   # optional override
#
# PREMIUM UPSELL route: Sync.so direct. Set ONE of these
# (LIP_SYNC_API_KEY wins if both are set) and select the route with
# LIP_SYNC_PROVIDER=sync.
LIP_SYNC_API_KEY=                                  # Sync.so route key
SYNC_LABS_API_KEY=                                 # alt name, same key
# Provider selector: "latentsync" (default when its key is set) or "sync".
LIP_SYNC_PROVIDER=                                 # optional
# Lip-sync model on the Sync.so route. Production: sync-3.
LIP_SYNC_MODEL=sync-3                              # optional, default lipsync-2 (code fallback)

# ── Demucs (server-side vocal isolation) ───────────────────────────────────
DEMUCS_PYTHON=python3                              # optional, default python3
DEMUCS_MODEL=mdx_extra_q                           # optional, default mdx_extra_q
DEMUCS_TIMEOUT_MS=600000                           # optional, default 600000 (10 min)
# LADSPA plugin path for the audio export chain (server audio tooling).
LADSPA_PATH=                                       # optional

# ── Feature credit costs (site credits charged per use) ────────────────────
CHAT_CREDIT_COST=1                                 # optional, default 1
HOOK_STUDIO_CREDIT_COST=1                          # optional, default 1
RANDOMIZER_CREDIT_COST=1                           # optional, default 1
MONETIZATION_COACH_CREDIT_COST=1                   # optional, default 1
SOUND_MATCH_CREDIT_COST=1                        # optional, default 1
RELEASE_PLAN_CREDIT_COST=2                         # optional, default 2BRAND_CALCULATOR_CREDIT_COST=2                    # optional, default 2ACADEMY_CREDIT_COST=1                              # optional, default 1 (per AI academy call)
CONTENT_CALENDAR_CREDIT_COST=1                    # optional, default 1
SCHEDULER_POST_CREDITS=1                         # optional, default 1 (per scheduled post)
SCHEDULER_BEST_TIME_CREDITS=1                    # optional, default 1 (per AI best-time suggestion)
MEDIA_IMPORT_CREDIT_COST=2                         # optional, default 2 (Media Importer: yt-dlp/direct download + storage)
TOUR_PLANNER_CREDIT_COST=3                        # optional, default 3 (AI routing + budget)
SETLIST_FLOW_CREDIT_COST=1                         # optional, default 1 (per AI setlist flow)
INTERVIEW_PREP_CREDIT_COST=2                     # optional, default 2 (per AI interview prep session)
INTERVIEW_FEEDBACK_CREDIT_COST=1                 # optional, default 1 (per AI practice-answer feedback)
ARTIST_IMAGE_CREDITS=3                             # optional, default 3 (Runway gen4_image)
ARTIST_IMAGE_TURBO_CREDITS=2                       # optional, default 2 (gen4_image_turbo)
ARTIST_IMAGE_SUNBURST_CREDITS=2                    # optional, default 2 (GPT Image 2.5)
# Master kill-switch for the artist voice-lock pipeline. Any value except
# "false" keeps it enabled.
ARTIST_VOICE_SWAP_ENABLED=true                     # optional, default enabled

# ── Storage ────────────────────────────────────────────────────────────────
# Default Supabase bucket id used by lip-sync stems, export doctor, watermark
# uploads. REQUIRED for those features; no default — set it.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# LEGACY Replit object-storage paths. Only needed if the old
# ObjectStorageService code paths are hit; throw a clear error when unset.
PUBLIC_OBJECT_SEARCH_PATHS=                        # legacy, comma-separated
PRIVATE_OBJECT_DIR=                                # legacy

# ── Admin ──────────────────────────────────────────────────────────────────
# Comma-separated owner emails. Fail-closed: no admins when unset.
ADMIN_EMAILS=blockdollazboss@gmail.com

# ── Legacy deploy ──────────────────────────────────────────────────────────
# Replit-era domains used for Stripe redirect URLs. On Render these are
# ignored (the request host is used instead). Safe to leave unset.
REPLIT_DOMAINS=                                    # legacy
REPLIT_DEV_DOMAIN=                                 # legacy

# ── Frontend (Vite — baked into the client bundle at build time) ───────────
# NOTE: anything VITE_ is public. Never put a real secret here.
# The server reads these too, as fallbacks for SUPABASE_URL / SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=https://xyzcompany.supabase.co   # REQUIRED (or SUPABASE_URL server-side)
VITE_SUPABASE_ANON_KEY=                            # REQUIRED (or SUPABASE_ANON_KEY server-side)
# Display-only flag used by the video editor's provider status list.
VITE_LIP_SYNC_API_KEY=                             # optional, boolean-ish flag

# ═══════════════════════════════════════════════════════════════════════════
# UPCOMING — landing with the auto-post PRs (not on main yet).
# Set these when PR #38 (Instagram), the TikTok branch, and the Facebook
# Pages branch merge. They are documented here now so the merge is clean.
# ═══════════════════════════════════════════════════════════════════════════

# ── Social auto-post: shared ───────────────────────────────────────────────
# AES-256-GCM key encrypting stored OAuth tokens (64 hex chars = 32 bytes).
# Generate: openssl rand -hex 32
# REQUIRED for any social connect/publish — the server refuses without it.
# Also encrypts stored Discord webhook URLs (Discord Live integration needs
# no additional env vars — the webhook URL is pasted per-user in Settings).
SOCIAL_TOKEN_KEY=

# ── Instagram (Meta app → Instagram product) ───────────────────────────────
# Instagram Login flow (instagram.com/oauth/authorize). In the Meta app
# dashboard: Instagram → "API setup with Instagram login" → copy the
# Instagram App ID and App Secret (NOT the Facebook App ID / META_APP_ID).
# The redirect URI below must be registered there as an OAuth redirect URI.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match the OAuth redirect URI registered in the Meta app dashboard.
META_REDIRECT_URI=https://bowdownvisuals.com/api/social/instagram/callback
# Credits charged per post (Meta's API is free; this is margin).
INSTAGRAM_POST_CREDITS=2                           # optional, default 2

# ── Facebook Pages (Meta app, legacy Facebook Login flow) ──────────────────
# Separate from Instagram above. Needs App Review approval for page scopes
# before real users can post.
META_APP_ID=
META_APP_SECRET=
# Must match the OAuth redirect URI registered in the Meta app dashboard.
META_FACEBOOK_REDIRECT_URI=https://bowdownvisuals.com/api/social/facebook/callback
# Credits charged per Facebook Page post (Meta API is free; this is margin).
FACEBOOK_POST_CREDITS=2

# ── Artist voice cloning ──────────────────────────────────────────────────
# Seconds of audio the from-song voice clone feeds to Demucs (loudest window).
# ElevenLabs IVC only needs ~30s of clean vocals; trimming first keeps the
# 10-minute Demucs timeout from tripping on full-length songs.
FROM_SONG_TRIM_SECONDS=90

# ── TikTok auto-post, DRAFTS tier (feature/tiktok-auto-post) ──────────────
# TikTok developer app. Create it at https://developers.tiktok.com/apps —
# enable the Login Kit (Web) product and request the `user.info.basic` and
# `video.upload` scopes. The app's review must approve `video.upload` before
# real users can connect.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match a Login Kit redirect URI registered in the TikTok app dashboard.
TIKTOK_REDIRECT_URI=https://bowdownvisuals.com/api/social/tiktok/callback
# Credits charged per TikTok draft upload (TikTok's API is free; this is margin).
TIKTOK_POST_CREDITS=2
# (SOCIAL_TOKEN_KEY above is reused to encrypt stored TikTok OAuth tokens.)

# ── Music model ────────────────────────────────────────────────────────────
ELEVENLABS_MUSIC_MODEL=music_v2_5                  # optional, default music_v2_5

# ── Go Live (native broadcasts) ───────────────────────────────────────────
# Go Live transport: "own" (default) = the site's own service carries the
# stream (browsers post short recording chunks; the API remuxes them into
# a live HLS feed; no keys, no per-minute bill). "cloudflare" = WHIP/
# WebRTC through Cloudflare Stream instead.
LIVE_TRANSPORT=
# Set to "off" to disable the own-server transport entirely (Go Live then
# answers the honest "isn't switched on yet" 503).
LIVE_OWN_SERVER=
# Cloudflare Stream live inputs — only used when LIVE_TRANSPORT=cloudflare.
# Set BOTH to switch that transport on; while either is unset, the
# Broadcast studio answers an honest "live streaming isn't switched on
# yet" (503 STREAM_NOT_CONFIGURED) — nothing fakes live.
# The token needs Stream:Edit on this account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
