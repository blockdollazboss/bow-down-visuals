# Discord bot env — copy to .env (never commit .env)
# See README.md for the full setup walkthrough.

# Required: bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Required: application Client ID (same portal → General Information)
DISCORD_CLIENT_ID=

# Required: random 32+ char secret shared with the api-server (DISCORD_BOT_SHARED_SECRET)
DISCORD_BOT_SHARED_SECRET=

# Where the api-server lives (the bot POSTs live-state transitions here)
API_BASE_URL=https://bowdownvisuals.com

# Fallbacks used when the site-side /discord-bot config isn't set yet
DISCORD_GUILD_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=
STREAMER_DISCORD_USER_ID=

# Optional: shown by the /socials command (comma-separated "Label|https://…" pairs)
SOCIALS_LINKS=

# Optional: URL the bot's "Streaming" presence points at (Twitch/YouTube)
STREAM_URL=
